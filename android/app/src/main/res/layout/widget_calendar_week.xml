<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layoutDirection="ltr">
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:importantForAccessibility="noHideDescendants">
  <LinearLayout android:id="@+id/widget_week_dates" android:layout_width="match_parent" android:layout_height="14sp" android:orientation="horizontal"/>
  <LinearLayout android:id="@+id/widget_week_lanes" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
  <LinearLayout android:id="@+id/widget_week_overflow" android:layout_width="match_parent" android:layout_height="10sp" android:orientation="horizontal"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_week_taps" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"/>
</FrameLayout>
