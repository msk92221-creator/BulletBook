rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(familyId) {
      return signedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }
    function owner(familyId) {
      return signedIn() && get(/databases/$(database)/documents/families/$(familyId)).data.ownerId == request.auth.uid;
    }
    function validMember(d) {
      return d.keys().hasOnly(['name','color','joinedAt','inviteCode'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.color in ['#4555ce','#d17a5d','#339985','#a46cc2','#bc942e','#458cc0']
        && d.joinedAt == request.time;
    }
    function invited(familyId, uid) {
      let code = request.resource.data.inviteCode;
      let before = get(/databases/$(database)/documents/invites/$(code)).data;
      let after = getAfter(/databases/$(database)/documents/invites/$(code)).data;
      return before.familyId == familyId && before.usedBy == '' && before.expiresAt > request.time
        && after.usedBy == uid && after.usedAt == request.time;
    }
    function validEvent(d) {
      return d.keys().hasOnly(['id','title','location','notes','startDate','endDate','startTime','endTime','allDay','repeat','repeatUntil','category','participants','isPrivate','createdBy','updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.location is string && d.location.size() <= 200
        && d.notes is string && d.notes.size() <= 3000
        && d.startDate is string && d.startDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.endDate is string && d.endDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && d.endDate >= d.startDate
        && d.startTime is string && d.startTime.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && d.endTime is string && d.endTime.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && d.allDay is bool && (d.allDay || d.endDate > d.startDate || d.endTime > d.startTime)
        && d.repeat in ['none','daily','weekly','monthly','yearly']
        && d.repeatUntil is string && (d.repeatUntil == '' || (d.repeatUntil.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && d.repeatUntil >= d.startDate))
        && d.category is string && d.category.matches('[a-zA-Z0-9_-]{1,64}')
        && d.participants is list && d.participants.size() <= 30
        && d.isPrivate is bool && d.createdBy is string && d.updatedAt == request.time;
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['familyId'])
        && existsAfter(/databases/$(database)/documents/families/$(request.resource.data.familyId)/members/$(uid));
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data == resource.data;
      match /privateEvents/{eventId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && validEvent(request.resource.data) && request.resource.data.id == eventId
          && request.resource.data.isPrivate == true && request.resource.data.createdBy == uid;
      }
    }
    match /families/{familyId} {
      allow read: if member(familyId);
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['name','ownerId','createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid));
      match /members/{uid} {
        allow read: if member(familyId);
        allow create: if signedIn() && request.auth.uid == uid && validMember(request.resource.data)
          && (getAfter(/databases/$(database)/documents/families/$(familyId)).data.ownerId == uid || invited(familyId,uid));
      }
      match /events/{eventId} {
        allow read, delete: if member(familyId);
        allow create: if member(familyId) && validEvent(request.resource.data)
          && request.resource.data.id == eventId && request.resource.data.isPrivate == false
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if member(familyId) && validEvent(request.resource.data)
          && request.resource.data.id == eventId && request.resource.data.isPrivate == false
          && request.resource.data.createdBy == resource.data.createdBy;
      }
      match /categories/{categoryId} {
        allow read: if member(familyId);
        // Keep deleted records so default categories stay deleted for every member.
        allow create, update: if member(familyId) && categoryId.matches('[a-zA-Z0-9_-]{1,64}')
          && categoryId != 'uncategorized'
          && request.resource.data.keys().hasOnly(['label','color','deleted','updatedAt'])
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0 && request.resource.data.label.size() <= 24
          && request.resource.data.color in ['#4555ce','#8260be','#257763','#bb5b3e','#b37419','#be517d','#327fba','#737b8c']
          && request.resource.data.deleted is bool && request.resource.data.updatedAt == request.time;
      }
    }
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if code.matches('[a-f0-9]{32}') && owner(request.resource.data.familyId)
        && request.resource.data.keys().hasOnly(['familyId','familyName','createdBy','expiresAt','usedBy','usedAt'])
        && request.resource.data.familyName == get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.name
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(25,'h')
        && request.resource.data.usedBy == '' && request.resource.data.usedAt == null;
      allow update: if signedIn() && resource.data.usedBy == '' && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy','usedAt'])
        && request.resource.data.usedBy == request.auth.uid && request.resource.data.usedAt == request.time
        && getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)/members/$(request.auth.uid)).data.inviteCode == code;
    }
  }
}
