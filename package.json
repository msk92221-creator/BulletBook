{
  "name": "bulletbook",
  "version": "0.42.0",
  "private": true,
  "description": "편집 가능한 불렛저널 - Windows와 Android 공통 앱",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "test:sync": "node scripts/test-cloud-merge.mjs",
    "test:routines": "node scripts/test-routine-dedupe.mjs",
    "test:layout": "node scripts/test-mobile-write-layout.mjs",
    "test:groups": "node scripts/test-group-hierarchy.mjs",
    "test:group-order": "node scripts/test-group-reorder.mjs",
    "test:drag-scroll": "node scripts/test-page-drag-scroll.mjs",
    "test:journal-order": "node scripts/test-journal-order.mjs",
    "test:existing-record-layout": "node scripts/test-existing-record-layout.mjs",
    "test:plan-dates": "node scripts/test-plan-dates.mjs",
    "test:notebook-navigation": "node scripts/test-notebook-navigation.mjs",
    "test:widget-startup": "node scripts/test-widget-startup.mjs",
    "test:widget-snapshot": "node scripts/test-widget-snapshot.mjs",
    "test:windows-host": "node scripts/test-windows-host.mjs",
    "android:sync": "npm run build:web && npx cap sync android && node scripts/vendor-capacitor.mjs",
    "android:open": "npx cap open android",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "test:family": "node scripts/test-family-calendar.mjs",
    "test:family-rules": "node scripts/test-family-rules.mjs",
    "test:family-connection": "node scripts/test-family-connection.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/core": "8.4.3",
    "firebase": "12.19.0",
    "lucide-react": "0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@firebase/rules-unit-testing": "5.0.0",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  }
}
